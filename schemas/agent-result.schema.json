{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforge.local/schemas/agent-result.schema.json",
  "title": "ProjectForge provider-neutral agent result contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "result_id",
    "assignment_id",
    "manifest_version",
    "status",
    "summary",
    "outputs",
    "evidence",
    "validation",
    "unresolved_questions",
    "risks",
    "assumptions",
    "handoff_notes",
    "attempt",
    "prior_result_id",
    "created_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "in_progress",
        "completed",
        "validated",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checks"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "not_run"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_notes": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "prior_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
