{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforge.local/schemas/agent-assignment.schema.json",
  "title": "ProjectForge agent assignment contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role_id", "name", "mission", "responsibilities", "exclusions", "inputs", "outputs", "dependencies", "acceptance_criteria", "handoff_requirements", "required_capabilities", "supporting_skills"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "responsibilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "handoff_requirements": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "supporting_skills": {"type": "array", "items": {"type": "string"}}
  }
}
